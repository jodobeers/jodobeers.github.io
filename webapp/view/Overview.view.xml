<mvc:View
    controllerName="jodobeers.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:IBAR="sap.m.IBar"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        title="{i18n>title}"
        titleAlignment="Center"
        backgroundDesign="Transparent"
    >
        <content>
            <FlexBox
                alignContent="Center"
                justifyContent="Center"
            >
                <sap.m:Image
                    src="./assets/img/Imagen1.jpg"
                    xmlns:sap.m="sap.m"
                    id="image0"
                />
            </FlexBox>
        </content>
        <IconTabBar
            id="idIconTabBarMulti"
            expanded="{device>/isNoPhone}"
            class="sapUiResponsiveContentPadding"
        >
            <items>
                <IconTabFilter
                    icon="sap-icon://hint"
                    text="Tipos de Cerveza"
                    key="info"
                    count="3"
                >
                    <Text text="Tipo de Cervezas" />
                    <HBox
                        items="{/cervezas}"
                        wrap="Wrap"
                        justifyContent="SpaceAround"
                    >
                        <!--                       
                        <VBox
                            class="sapUiSmallMargin"
                            width="300px"
                            alignItems="Center"
                        >
                        -->
                        <GenericTile
                            header="{nombre}"
                            press=".onPressTile"
                            class="tileLayout"
                            systemInfo="{tipo}"
                        >
                            <TileContent>
                                <ImageContent src="{imagen}" />
                            </TileContent>
                        </GenericTile>
                        <!--                        
                            <Image
                                src="{imagen}"
                                width="100%"
                                height="200px"
                                densityAware="false"
                                class="sapUiSmallMarginBottom"
                            />
                            <Title
                                text="{nombre}"
                                titleStyle="H3"
                                class="sapUiSmallMarginBottom"
                            />
                            <Text
                                text="{descripcion}"
                                textAlign="Center"
                            />
 -->
                        <!--   
                        </VBox>
                        -->
                    </HBox>
                </IconTabFilter>
                <IconTabFilter
                    icon="sap-icon://attachment"
                    key="Localización"
                    text="Localizacion"
                >
                    <Text text="Attachments go here ..." />
                </IconTabFilter>
                <IconTabFilter
                    icon="sap-icon://leads"
                    text="Propietarios"
                    key="notes"
                    count="5"
                >
                    <Text text="Propietarios ..." />
                    <HBox
                        items="{/propietarios}"
                        wrap="Wrap"
                        justifyContent="SpaceAround"
                    >
                        <VBox
                            class="sapUiSmallMargin"
                            width="300px"
                            alignItems="Center"
                        >
                            <Image
                                src="{foto}"
                                width="100%"
                                height="200px"
                                densityAware="false"
                                class="sapUiSmallMarginBottom"
                            />
                            <Title
                                text="{nombre} / {alias}"
                                titleStyle="H2"
                                class="sapUiSmallMarginBottom"
                            />
                            <Text
                                text="{descripcion}"
                                textAlign="Center"
                            />
                        </VBox>
                    </HBox>
                </IconTabFilter>
                <IconTabFilter
                    icon="sap-icon://widgets"
                    key="rockandroll"
                    text="Rock and Roll"
                >
                    <Text text="Rock and Roll ..." />
                    <VBox
                        items="{/multimedia}"
                        class="sapUiMediumMargin"
                        width="50%"
                        direction="Column"
                    >
                        <VBox class="sapUiSmallMarginBottom">
                            <Title
                                text="{titulo}"
                                titleStyle="H5"
                            />
                            <core:HTML content="{audioHtml}" />
                        </VBox>
                    </VBox>
                </IconTabFilter>
            </items>
        </IconTabBar>

        <content>
            <GenericTile
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                header="JodoJessica D. Prince Senior Consultant"
                subheader="Black Beer"
                press=".press"
                appShortcut="shortcut"
                systemInfo="systeminfo"
            >
                <TileContent>
                    <ImageContent src="./assets/img/6A.jpg" />
                </TileContent>
            </GenericTile>
        </content>
    </Page>
</mvc:View>
